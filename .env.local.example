# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public production URL used for OAuth redirects.
NEXT_PUBLIC_APP_URL=https://luxury-hub-zeta.vercel.app

# Google OAuth Web Application credentials.
# Authorized redirect URI must include:
# https://luxury-hub-zeta.vercel.app/api/gmail/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Generate a random 32-byte key and base64 encode it.
# Used server-side to encrypt stored Gmail refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
